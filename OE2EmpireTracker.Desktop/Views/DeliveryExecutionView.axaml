<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.DeliveryExecutionView"
             x:DataType="vm:DeliveryExecutionViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Text="Delivery Execution"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid RowDefinitions="Auto,8,*,8,Auto,*,Auto">
            <!-- Top: Plan selection -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Plan:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Plans}"
                          SelectedItem="{Binding SelectedPlan}"
                          MinWidth="250">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PlanName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Middle: Stops list -->
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Stops"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Stops}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Sequence}" FontWeight="Bold" Width="24" />
                                <TextBlock Text="{Binding DestinationName}" />
                                <CheckBox IsChecked="{Binding StopCompleted}" IsEnabled="False" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Bottom: Load list DataGrid -->
            <TextBlock Grid.Row="4"
                       Text="Load List"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <DataGrid Grid.Row="5"
                      ItemsSource="{Binding LoadItems}"
                      SelectedItem="{Binding SelectedLoadItem}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item"
                                        Binding="{Binding ItemName}"
                                        Width="200" />
                    <DataGridTextColumn Header="Quantity"
                                        Binding="{Binding Quantity}"
                                        Width="100" />
                    <DataGridCheckBoxColumn Header="Delivered"
                                            Binding="{Binding Delivered}"
                                            Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Mark Delivered button -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Content="Mark Delivered"
                        Command="{Binding MarkDeliveredCommand}" />
            </StackPanel>
        </Grid>
    </DockPanel>

</UserControl>
