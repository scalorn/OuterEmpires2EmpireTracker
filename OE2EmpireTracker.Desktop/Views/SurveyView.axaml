<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:ctrl="using:OE2EmpireTracker.Desktop.Controls"
             x:Class="OE2EmpireTracker.Desktop.Views.SurveyView"
             x:DataType="vm:SurveyViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Text="Surveys"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid ColumnDefinitions="250,12,*">
            <!-- Left: Survey list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Survey List"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Surveys}"
                         SelectedItem="{Binding SelectedSurvey}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding PlanetName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SurveyType}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: Resources grid + distribution chart -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Resources"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text="Distribution:" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding AvailableCombos}"
                                  SelectedItem="{Binding SelectedCombo}"
                                  MinWidth="200" />
                    </StackPanel>
                    <sp:AvaPlot x:Name="DistributionPlot" MinHeight="200" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding Resources}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          ctrl:DataGridPersistence.GridId="SurveyResources">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Resource"
                                            Binding="{Binding ResourceName}"
                                            Width="180" />
                        <DataGridTextColumn Header="Purity"
                                            Binding="{Binding Purity}"
                                            Width="100" />
                        <DataGridTextColumn Header="Yield"
                                            Binding="{Binding Yield}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>

</UserControl>
