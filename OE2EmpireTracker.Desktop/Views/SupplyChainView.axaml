<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.SupplyChainView"
             x:DataType="vm:SupplyChainViewModel">

    <Grid ColumnDefinitions="250,12,*" Margin="8">
        <!-- Left panel: Chain list -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Supply Chains"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <DataGrid ItemsSource="{Binding Chains}"
                      SelectedItem="{Binding SelectedChain}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Chain"
                                        Binding="{Binding ChainName}"
                                        Width="150" />
                    <DataGridTextColumn Header="Stages"
                                        Binding="{Binding StageCount}"
                                        Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right panel: Stages grid -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top"
                       Text="Stages"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Spacing="8">
                <Button Content="Add Stage"
                        Command="{Binding AddStageCommand}" />
                <Button Content="Remove Stage"
                        Command="{Binding RemoveStageCommand}" />
                <Button Content="Save"
                        Command="{Binding SaveChainCommand}" />
            </StackPanel>

            <DataGrid ItemsSource="{Binding Stages}"
                      SelectedItem="{Binding SelectedStage}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="False"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Seq"
                                        Binding="{Binding Sequence}"
                                        Width="60" />
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding StageType}"
                                        Width="100" />
                    <DataGridTextColumn Header="Resource"
                                        Binding="{Binding ResourceName}"
                                        Width="120" />
                    <DataGridTextColumn Header="Purity"
                                        Binding="{Binding ResourcePurity}"
                                        Width="80" />
                    <DataGridTextColumn Header="Threshold"
                                        Binding="{Binding AccumulationThreshold}"
                                        Width="90" />
                    <DataGridTextColumn Header="Location"
                                        Binding="{Binding Location}"
                                        Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>

</UserControl>
