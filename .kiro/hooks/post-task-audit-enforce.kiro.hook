{
  "enabled": true,
  "name": "Enforce Audit After Task",
  "description": "After completing a spec task, runs the full audit suite. Exit code 1 means findings exist and the agent MUST fix them before proceeding.",
  "version": "2",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "node .kiro/tools/audit.js"
  }
}
