<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.BlueprintView"
             x:DataType="vm:BlueprintViewModel">

    <Grid ColumnDefinitions="260,12,*" Margin="8">
        <!-- Left panel: Blueprint list -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Blueprints"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <ListBox ItemsSource="{Binding Blueprints}"
                     SelectedItem="{Binding SelectedBlueprint}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding BlueprintType}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding TechLevel}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right panel: Edit fields + TabControl -->
        <DockPanel Grid.Column="2">
            <!-- Edit fields and CRUD buttons -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="8">
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditName}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditBlueprintType}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tech Level:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditTechLevel}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="New" Command="{Binding NewBlueprintCommand}" />
                    <Button Content="Save" Command="{Binding SaveBlueprintCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteBlueprintCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- TabControl with details -->
            <TabControl>
                <!-- Details Tab -->
                <TabItem Header="Details">
                    <StackPanel Margin="0,8,0,0" Spacing="8">
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailName}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailType}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tech Level:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailTechLevel}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ship Class:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailShipClass}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Evolution:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailEvolution}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Statistics Tab -->
                <TabItem Header="Statistics">
                    <DataGrid Margin="0,8,0,0"
                              ItemsSource="{Binding Stats}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stat" Binding="{Binding StatName}" Width="200" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Resources Tab -->
                <TabItem Header="Resources">
                    <DataGrid Margin="0,8,0,0"
                              ItemsSource="{Binding Resources}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Resource" Binding="{Binding ResourceName}" Width="200" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Evolution Tab -->
                <TabItem Header="Evolution">
                    <StackPanel Margin="0,8,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Evolution chart — ScottPlot integration pending"
                                   FontSize="16"
                                   Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>

</UserControl>
