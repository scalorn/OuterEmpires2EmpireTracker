<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <StackPanel Margin="40" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="{Binding Version}" FontSize="16" Foreground="Gray" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400" />
        <TextBlock Text="{Binding Framework}" FontSize="12" Foreground="DimGray" Margin="0,16,0,0" />
    </StackPanel>

</UserControl>
