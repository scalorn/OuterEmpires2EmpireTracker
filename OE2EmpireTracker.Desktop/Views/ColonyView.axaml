<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.ColonyView"
             x:DataType="vm:ColonyViewModel">

    <Grid ColumnDefinitions="250,12,*" Margin="8">
        <!-- Left panel: Colony list -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Colonies"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <ListBox ItemsSource="{Binding Colonies}"
                     SelectedItem="{Binding SelectedColony}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding ColonyName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PlanetName}" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right panel: TabControl -->
        <DockPanel Grid.Column="2">
            <!-- Action buttons -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,8">
                <Button Content="Save" Command="{Binding SaveColonyCommand}" />
                <Button Content="Delete" Command="{Binding DeleteColonyCommand}" />
                <Button Content="Import Clipboard" Command="{Binding ImportClipboardCommand}" />
                <Button Content="Import File" Command="{Binding ImportFileCommand}" />
            </StackPanel>
            <!-- Import/validation status -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding ImportStatus}"
                       Foreground="Orange"
                       IsVisible="{Binding ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Margin="0,0,0,4" />
            <!-- Validation error display -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding ValidationError}"
                       Foreground="Red"
                       IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Margin="0,0,0,8" />
            <TabControl>
            <!-- Structures Tab -->
            <TabItem Header="Structures">
                <DockPanel Margin="0,8,0,0">
                    <!-- Assignment panel at bottom -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,8,0,0"
                            IsVisible="{Binding SelectedStructure, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Structure Assignment" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="Auto,8,*,16,Auto,8,*" RowDefinitions="Auto,8,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Resource:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding AssignResource}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Purity:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding AssignPurity}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Blueprint:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding AssignBlueprintUuid}" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="Quantity:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="2" Grid.Column="6" Value="{Binding AssignQuantity}" Minimum="1" Maximum="9999" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Content="Assign Mining" Command="{Binding AssignMiningCommand}" />
                                <Button Content="Assign Refining" Command="{Binding AssignRefiningCommand}" />
                                <Button Content="Assign Manufacturing" Command="{Binding AssignManufacturingCommand}" />
                                <Button Content="Assign Research" Command="{Binding AssignResearchCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Content="Add Structure"
                                Command="{Binding AddStructureCommand}" />
                        <Button Content="Remove Structure"
                                Command="{Binding RemoveStructureCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Structures}"
                              SelectedItem="{Binding SelectedStructure}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Structure" Binding="{Binding StructureName}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="Type" Binding="{Binding StructureType}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                            <DataGridTextColumn Header="ID" Binding="{Binding BuildingId}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Commodities Tab -->
            <TabItem Header="Commodities">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Content="Add Commodity"
                                Command="{Binding AddCommodityCommand}" />
                        <Button Content="Remove Commodity"
                                Command="{Binding RemoveCommodityCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Commodities}"
                              SelectedItem="{Binding SelectedCommodity}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Commodity" Binding="{Binding CommodityName}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="Requested" Binding="{Binding Requested}" Width="100" />
                            <DataGridTextColumn Header="Delivered" Binding="{Binding Delivered}" Width="100" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Fulfilled" Binding="{Binding Fulfilled}" Width="80" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Items Tab (D4: Editable) -->
            <TabItem Header="Items">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Content="Add Item"
                                Command="{Binding AddItemCommand}" />
                        <Button Content="Remove Item"
                                Command="{Binding RemoveItemCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="200" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100" />
                            <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Overflow Tab (D5: Editable) -->
            <TabItem Header="Overflow">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Content="Add Rule"
                                Command="{Binding AddOverflowRuleCommand}" />
                        <Button Content="Remove Rule"
                                Command="{Binding RemoveOverflowRuleCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding OverflowRules}"
                              SelectedItem="{Binding SelectedOverflowRule}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Resource" Binding="{Binding ResourceName}" Width="160" />
                            <DataGridTextColumn Header="Purity" Binding="{Binding Purity}" Width="100" />
                            <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="100" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Activity/Admin Tab (D7) -->
            <TabItem Header="Admin">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Content="Generate Build Plan"
                                Command="{Binding GenerateBuildPlanCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Colony Admin Summary"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AdminSummary}"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ActivityStatus}"
                                   FontSize="14"
                                   Opacity="0.6" />
                    </StackPanel>
                </DockPanel>
            </TabItem>
        </TabControl>
        </DockPanel>
    </Grid>

</UserControl>
