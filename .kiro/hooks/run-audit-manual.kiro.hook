{
  "enabled": true,
  "name": "Run Full Audit (Manual)",
  "description": "Runs the full audit suite on demand when manually triggered by the user.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "node .kiro/tools/audit.js --fix",
    "timeout": 120
  }
}
