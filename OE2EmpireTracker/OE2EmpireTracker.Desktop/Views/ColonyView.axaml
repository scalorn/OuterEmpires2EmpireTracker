<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.ColonyView"
             x:DataType="vm:ColonyViewModel">

    <Grid ColumnDefinitions="250,12,*" Margin="8">
        <!-- Left panel: Colony list -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Colonies"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <ListBox ItemsSource="{Binding Colonies}"
                     SelectedItem="{Binding SelectedColony}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding ColonyName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PlanetName}" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right panel: Detail + TabControl -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <!-- Detail editing fields and CRUD buttons -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="8">
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Colony Name:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditColonyName}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Planet:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditPlanetName}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="System:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditSystemName}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="New" Command="{Binding NewColonyCommand}" />
                    <Button Content="Save" Command="{Binding SaveColonyCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteColonyCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- TabControl -->
            <TabControl Grid.Row="1">
                <!-- Structures Tab -->
                <TabItem Header="Structures">
                    <DataGrid Margin="0,8,0,0"
                              ItemsSource="{Binding Structures}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Structure" Binding="{Binding StructureName}" Width="180" />
                            <DataGridTextColumn Header="Type" Binding="{Binding StructureType}" Width="140" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                            <DataGridTextColumn Header="ID" Binding="{Binding BuildingId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Commodities Tab -->
                <TabItem Header="Commodities">
                    <DataGrid Margin="0,8,0,0"
                              ItemsSource="{Binding Commodities}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Commodity" Binding="{Binding CommodityName}" Width="180" />
                            <DataGridTextColumn Header="Requested" Binding="{Binding Requested}" Width="100" />
                            <DataGridTextColumn Header="Delivered" Binding="{Binding Delivered}" Width="100" />
                            <DataGridCheckBoxColumn Header="Fulfilled" Binding="{Binding Fulfilled}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Items Tab -->
                <TabItem Header="Items">
                    <DataGrid Margin="0,8,0,0"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="200" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100" />
                            <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Overflow Tab -->
                <TabItem Header="Overflow">
                    <DataGrid Margin="0,8,0,0"
                              ItemsSource="{Binding OverflowRules}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Resource" Binding="{Binding ResourceName}" Width="160" />
                            <DataGridTextColumn Header="Purity" Binding="{Binding Purity}" Width="100" />
                            <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="100" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Activity Tab -->
                <TabItem Header="Activity">
                    <StackPanel Margin="0,8,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ActivityStatus}"
                                   FontSize="16"
                                   Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>

</UserControl>
