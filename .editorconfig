# Top-level EditorConfig for OE2EmpireTracker
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
# --- Formatting ---
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true

# --- Naming conventions ---
# Private fields: _camelCase
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore.required_prefix = _
dotnet_naming_style.camel_case_underscore.capitalization = camel_case

# Public members: PascalCase
dotnet_naming_rule.public_members_should_be_pascal_case.severity = warning
dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case
dotnet_naming_symbols.public_members.applicable_kinds = property, method, event
dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Constants: PascalCase
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

# Local variables: camelCase
dotnet_naming_rule.locals_should_be_camel_case.severity = suggestion
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case_style
dotnet_naming_symbols.locals.applicable_kinds = local, parameter
dotnet_naming_style.camel_case_style.capitalization = camel_case

# --- Using directives ---
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# --- Expression preferences ---
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_braces = when_multiline:suggestion

# --- StyleCop rule severity overrides ---
# SA1101: Prefix local calls with this — disabled (project doesn't use this. prefix)
dotnet_diagnostic.SA1101.severity = none
# SA1200: Using directives should be placed correctly — we use outside namespace
dotnet_diagnostic.SA1200.severity = none
# SA1309: Field names should not begin with underscore — conflicts with our _camelCase convention
dotnet_diagnostic.SA1309.severity = none
# SA1633: File should have header — no file headers in this project
dotnet_diagnostic.SA1633.severity = none
# SA1600: Elements should be documented — too noisy for existing codebase
dotnet_diagnostic.SA1600.severity = suggestion
# SA1601: Partial elements should be documented — Designer.cs files
dotnet_diagnostic.SA1601.severity = none
# SA1602: Enumeration items should be documented
dotnet_diagnostic.SA1602.severity = none
# SA1516: Elements should be separated by blank line — too strict for compact code
dotnet_diagnostic.SA1516.severity = suggestion
# SA1413: Use trailing comma in multi-line initializers
dotnet_diagnostic.SA1413.severity = none
# SA1503: Braces should not be omitted — allow single-line if/return
dotnet_diagnostic.SA1503.severity = suggestion
# SA1128: Put constructor initializers on their own line
dotnet_diagnostic.SA1128.severity = none
# SA1502: Element should not be on a single line — allow compact property accessors
dotnet_diagnostic.SA1502.severity = none
# SA1127: Generic type constraints should be on their own line
dotnet_diagnostic.SA1127.severity = none
# SA1512: Single-line comments should not be followed by blank line — too strict for test arrange/act/assert sections
dotnet_diagnostic.SA1512.severity = none
# SA1515: Single-line comment should be preceded by blank line — too strict for inline comments
dotnet_diagnostic.SA1515.severity = none
# SA1025: Code should not contain multiple whitespace in a row — alignment whitespace is intentional
dotnet_diagnostic.SA1025.severity = none
# SA0001: XML comment analysis disabled — we don't generate XML docs
dotnet_diagnostic.SA0001.severity = none
# SA1402: File may only contain a single type — test helper classes colocated with tests
dotnet_diagnostic.SA1402.severity = suggestion
# SA1649: File name should match first type name — test files sometimes have helper classes
dotnet_diagnostic.SA1649.severity = suggestion

# --- Designer.cs files: suppress most style rules ---
[*.Designer.cs]
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1400.severity = none
dotnet_diagnostic.SA1306.severity = none
generated_code = true

# --- Test project: relax rules that conflict with test patterns ---
[OE2EmpireTracker.Tests/**/*.cs]
# SA1124: Regions are used for test organization (Arrange/Act/Assert, test categories)
dotnet_diagnostic.SA1124.severity = none
# SA1117/SA1116/SA1118: Multi-line parameter calls are common in test setup with many params
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1116.severity = none
dotnet_diagnostic.SA1118.severity = none
# SA1009: FsCheck LINQ query style uses trailing closing parens
dotnet_diagnostic.SA1009.severity = none
# SA1122: "" is clearer than string.Empty in test assertions
dotnet_diagnostic.SA1122.severity = none
# SA1111: Closing paren placement in multi-line FsCheck queries
dotnet_diagnostic.SA1111.severity = none
# SA1500: Compact brace style in test lambda expressions
dotnet_diagnostic.SA1500.severity = none
# SA1119: Extra parentheses for clarity in test assertions
dotnet_diagnostic.SA1119.severity = none
# SA1407: Arithmetic precedence — explicit in test calculations
dotnet_diagnostic.SA1407.severity = none
# SA1208/SA1210/SA1211: Using directive ordering — System before project namespaces, alphabetical
dotnet_diagnostic.SA1208.severity = none
dotnet_diagnostic.SA1210.severity = none
dotnet_diagnostic.SA1211.severity = none
# SA1201/SA1202/SA1203/SA1204: Member ordering — test helpers mixed with tests
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1203.severity = none
dotnet_diagnostic.SA1204.severity = none
# SA1501: Single-line statements — compact test setup lambdas
dotnet_diagnostic.SA1501.severity = none
# SA1114/SA1115: Parameter list placement — multi-line test case data
dotnet_diagnostic.SA1114.severity = none
dotnet_diagnostic.SA1115.severity = none
# SA1400: Access modifier — test helper methods
dotnet_diagnostic.SA1400.severity = none
# SA1300: Element naming — local function naming in tests
dotnet_diagnostic.SA1300.severity = none
# SA1312: Variable naming — discard variables
dotnet_diagnostic.SA1312.severity = none
# SA1121: Use built-in type alias
dotnet_diagnostic.SA1121.severity = none
# SA1108: Block statements embedded comments
dotnet_diagnostic.SA1108.severity = none
# SA1519: Multi-line foreach/if with Assert.That — braces omitted for readability in tests
dotnet_diagnostic.SA1519.severity = none
