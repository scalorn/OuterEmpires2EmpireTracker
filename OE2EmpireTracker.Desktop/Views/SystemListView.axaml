<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.SystemListView"
             x:DataType="vm:SystemListViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Text="Star Systems"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <DataGrid ItemsSource="{Binding Systems}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="System Name"
                                    Binding="{Binding SystemName}"
                                    Width="250" />
                <DataGridTextColumn Header="Asteroids"
                                    Binding="{Binding AsteroidCount}"
                                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</UserControl>
