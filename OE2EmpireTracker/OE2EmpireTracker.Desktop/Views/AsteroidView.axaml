<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.AsteroidView"
             x:DataType="vm:AsteroidViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Text="Asteroids"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBox Text="{Binding EditAsteroidName}" Watermark="Asteroid Name" MinWidth="200" />
            <TextBox Text="{Binding EditSystemName}" Watermark="System Name" MinWidth="150" />
            <Button Content="New" Command="{Binding NewAsteroidCommand}" />
            <Button Content="Save" Command="{Binding SaveAsteroidCommand}" />
            <Button Content="Delete" Command="{Binding DeleteAsteroidCommand}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Asteroids}"
                  SelectedItem="{Binding SelectedAsteroid}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Asteroid"
                                    Binding="{Binding AsteroidName}"
                                    Width="200" />
                <DataGridTextColumn Header="System"
                                    Binding="{Binding SystemName}"
                                    Width="150" />
                <DataGridTextColumn Header="Reserves"
                                    Binding="{Binding ReserveCount}"
                                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</UserControl>
