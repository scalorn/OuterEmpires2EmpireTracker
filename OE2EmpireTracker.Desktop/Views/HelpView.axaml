<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.HelpView"
             x:DataType="vm:HelpViewModel">

    <Grid ColumnDefinitions="220,8,*">
        <!-- Topic List -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Help Topics"
                           FontWeight="SemiBold"
                           Margin="12,12,12,8" />
                <ListBox ItemsSource="{Binding Topics}"
                         SelectedItem="{Binding SelectedTopic}"
                         Margin="4,0,4,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"
                                       Padding="8,4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="Transparent" />

        <!-- Content Area -->
        <DockPanel Grid.Column="2">
            <!-- Related Topics (bottom) -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,8"
                    IsVisible="{Binding RelatedTopics.Count}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Related Topics"
                               FontWeight="SemiBold"
                               FontSize="12" />
                    <ItemsControl ItemsSource="{Binding RelatedTopics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RelatedTopicItem">
                                <Button Content="{Binding DisplayName}"
                                        Command="{Binding $parent[UserControl].((vm:HelpViewModel)DataContext).NavigateLinkCommand}"
                                        CommandParameter="{Binding FileName}"
                                        Margin="0,0,8,4"
                                        Padding="8,4"
                                        FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Markdown content -->
            <ScrollViewer Padding="24,12">
                <TextBlock Text="{Binding Content}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           FontFamily="Consolas, Courier New, monospace"
                           MaxWidth="800" />
            </ScrollViewer>
        </DockPanel>
    </Grid>

</UserControl>
