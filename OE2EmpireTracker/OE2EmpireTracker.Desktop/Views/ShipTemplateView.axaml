<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.ShipTemplateView"
             x:DataType="vm:ShipTemplateViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Text="Ship Templates"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid RowDefinitions="*,8,Auto,*">
            <!-- Template list -->
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Templates}"
                      SelectedItem="{Binding SelectedTemplate}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Template"
                                        Binding="{Binding TemplateName}"
                                        Width="200" />
                    <DataGridTextColumn Header="Hull Class"
                                        Binding="{Binding HullClass}"
                                        Width="150" />
                    <DataGridTextColumn Header="Slots"
                                        Binding="{Binding SlotCount}"
                                        Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Slot buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Text="Slots"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="Add Slot"
                        Command="{Binding AddSlotCommand}" />
                <Button Content="Remove Slot"
                        Command="{Binding RemoveSlotCommand}" />
                <Button Content="Save Slots"
                        Command="{Binding SaveSlotsCommand}" />
            </StackPanel>

            <!-- Slot grid -->
            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding Slots}"
                      SelectedItem="{Binding SelectedSlot}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="False"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Slot Type"
                                        Binding="{Binding SlotType}"
                                        Width="150" />
                    <DataGridTextColumn Header="Index"
                                        Binding="{Binding SlotIndex}"
                                        Width="80" />
                    <DataGridTextColumn Header="Blueprint"
                                        Binding="{Binding BlueprintName}"
                                        Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>

</UserControl>
