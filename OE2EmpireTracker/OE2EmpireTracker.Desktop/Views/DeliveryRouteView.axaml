<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OE2EmpireTracker.Desktop.ViewModels"
             x:Class="OE2EmpireTracker.Desktop.Views.DeliveryRouteView"
             x:DataType="vm:DeliveryRouteViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Text="Delivery Routes"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid ColumnDefinitions="250,12,*">
            <!-- Left: Route list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Routes"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Routes}"
                         SelectedItem="{Binding SelectedRoute}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding RouteName}" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Opacity="0.7">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} stops">
                                            <Binding Path="StopCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: TabControl with Stops and Plans -->
            <TabControl Grid.Column="2">
                <!-- Stops Tab -->
                <TabItem Header="Stops">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,8,0,0">
                            <Button Content="Add Stop"
                                    Command="{Binding AddStopCommand}" />
                            <Button Content="Remove Stop"
                                    Command="{Binding RemoveStopCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding RouteStops}"
                                  SelectedItem="{Binding SelectedStop}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Sequence}"
                                                    Width="50" />
                                <DataGridTextColumn Header="Destination"
                                                    Binding="{Binding DestinationName}"
                                                    Width="200" />
                                <DataGridTextColumn Header="Purpose"
                                                    Binding="{Binding Purpose}"
                                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Plans Tab -->
                <TabItem Header="Plans">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,0,0,8">
                            <Button Content="Add Plan"
                                    Command="{Binding AddPlanCommand}" />
                            <Button Content="Remove Plan"
                                    Command="{Binding RemovePlanCommand}" />
                        </StackPanel>
                        <Grid RowDefinitions="Auto,8,*">
                            <!-- Plan list -->
                            <ListBox Grid.Row="0"
                                     ItemsSource="{Binding Plans}"
                                     SelectedItem="{Binding SelectedPlan}"
                                     MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding PlanName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StopCount, StringFormat='{}{0} stops'}"
                                                       FontSize="12" Opacity="0.7"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Plan stop details -->
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding PlanStopDetails}"
                                      AutoGenerateColumns="False"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding Sequence}"
                                                        Width="50" />
                                    <DataGridTextColumn Header="Destination"
                                                        Binding="{Binding DestinationName}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="Drop Off"
                                                        Binding="{Binding DropOffSummary}"
                                                        Width="200" />
                                    <DataGridTextColumn Header="Pick Up"
                                                        Binding="{Binding PickUpSummary}"
                                                        Width="200" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

</UserControl>
