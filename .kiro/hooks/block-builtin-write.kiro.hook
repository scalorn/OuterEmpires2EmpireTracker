{
    "enabled":  true,
    "name":  "Block Built-in Write Tools",
    "description":  "Blocks use of fsWrite, fsAppend, and strReplace tools. All file edits must go through .kiro/tools/fwrite.js instead.",
    "version":  "1",
    "when":  {
                 "type":  "preToolUse",
                 "toolTypes":  [
                                   "fsWrite",
                                   "fsAppend",
                                   "strReplace"
                               ]
             },
    "then":  {
                 "type":  "askAgent",
                 "prompt":  "ACCESS DENIED. You are about to use a BANNED tool. fsWrite, fsAppend, and strReplace are FORBIDDEN in this project. They have size limits that cause silent failures. Use .kiro/tools/fwrite.js via executePwsh instead. See .kiro/steering/tech.md for usage examples. Do NOT retry this tool call."
             }
}